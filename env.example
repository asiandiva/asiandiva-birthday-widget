# Copy this file to .env locally (do NOT commit .env)
# On Render, set these in Dashboard → Environment

# Your Twitch app's Client ID
TWITCH_CLIENT_ID=c76fsghzngwflbmg06o6c9hj2ffub2

# Your USER access token (the one with channel:read:subscriptions + bits:read scopes)
# Get one from https://twitchtokengenerator.com — pick the scopes listed in the README.
TWITCH_USER_TOKEN=paste_your_access_token_here

# OPTIONAL — your REFRESH token from twitchtokengenerator (the second one shown).
# Set this to enable automatic token renewal so the access token never expires
# on you mid-stream. Leave blank/unset to keep the old manual behavior.
TWITCH_REFRESH_TOKEN=paste_your_refresh_token_here

# Your broadcaster user ID
TWITCH_BROADCASTER_ID=716266770

# Your Twitch channel login name (lowercase). Used for the IRC connection
# that parses Blerp bot chat messages.
TWITCH_CHANNEL=asiandiva__

# The chat username of the Blerp bot (lowercase). Default 'blerp'.
BLERP_BOT=blerp

# Port (Render sets this automatically, leave as 3000 for local dev)
PORT=3000
